generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

// A delisted game, indexed as a catalogue record. There are NO delisting
// dates: IGDB cannot reliably say *when* a title left a storefront, so the
// product treats "delisted" as a status flag and focuses on attributes.
model Game {
  id     String @id @default(cuid())
  igdbId Int?   @unique
  slug   String @unique
  name   String

  // Library-style stable identifier shown on every record card (e.g. DG.823.4).
  // Derived deterministically from igdbId so it never drifts between syncs.
  callNumber String @unique

  summary        String?
  firstReleaseAt DateTime?
  // Denormalised for fast faceting on the Catalog/Insights surfaces.
  releaseYear    Int?
  decade         String?

  coverUrl       String?
  artworkUrls    String? // JSON-serialised string[]
  screenshotUrls String? // JSON-serialised string[]

  // IGDB scores (0–100). aggregated/total mirror IGDB's own fields.
  rating           Float?
  aggregatedRating Float?
  totalRating      Float?
  ratingCount      Int?
  // RAWG fallback metric, only populated when IGDB lacks scores.
  metacritic       Int?

  publisher String?
  developer String?

  ageRatings String? // JSON-serialised { category: string; rating: string }[]
  websites   String? // JSON-serialised { category: string; url: string }[]

  // Extra IGDB attributes for richer faceting / insights.
  gameModes          String? // JSON-serialised string[]
  themes             String? // JSON-serialised string[]
  playerPerspectives String? // JSON-serialised string[]
  franchise          String?

  // IGDB status enum: 5 = offline, 8 = delisted. statusLabel is the
  // human-facing word used across the UI.
  igdbStatus  Int?
  statusLabel String @default("delisted")

  // Mature/sexual content flag. Derived from IGDB themes ("Erotic"), age
  // ratings (AO), and title/summary keywords. NSFW records stay in the data
  // (insights/aggregates) but are hidden from browsing views unless the
  // visitor opts in via the NSFW toggle.
  nsfw Boolean @default(false)

  // Which source filled publisher/developer when IGDB was sparse.
  enrichedFrom String? // "igdb" | "igdb+rawg"

  igdbUpdatedAt DateTime?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platforms GamePlatform[]
  genres    GameGenre[]

  @@index([releaseYear])
  @@index([decade])
  @@index([rating])
  @@index([publisher])
  @@index([nsfw])
}

model Platform {
  id           String         @id @default(cuid())
  igdbId       Int?           @unique
  slug         String         @unique
  name         String
  abbreviation String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  games        GamePlatform[]
}

model Genre {
  id        String      @id @default(cuid())
  igdbId    Int?        @unique
  slug      String      @unique
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  games     GameGenre[]
}

model GamePlatform {
  gameId     String
  platformId String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([gameId, platformId])
}

model GameGenre {
  gameId  String
  genreId String
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
}

// Generic request cache for IGDB (apicalypse) queries. Anything that hits
// api.igdb.com goes through this so we never re-issue the same query within
// its TTL — cuts API usage to near zero once the catalogue is warm.
model IgdbRequest {
  id        String    @id @default(cuid())
  cacheKey  String    @unique
  endpoint  String
  query     String
  response  String
  fetchedAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([endpoint])
  @@index([fetchedAt])
}

// User-driven search cache: when a visitor searches for a game that isn't
// in the catalogue, we fall through to IGDB and cache the result here for
// 30 days. Page-level search consults this table BEFORE hitting IGDB.
//
// outcome: "added" | "not_delisted" | "not_found"
model UserSearchCache {
  id           String   @id @default(cuid())
  query        String   @unique
  outcome      String
  message      String
  igdbGameId   Int?
  matchedTitle String?
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}
